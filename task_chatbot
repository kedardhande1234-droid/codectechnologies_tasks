    print("Bot: I am an NLP-based customer service chatbot.")
    print("Bot: Type 'bye' anytime to end the conversation.")
    print()

    while True:

        user_input = input("You: ").strip()

        if user_input == "":
            print("Bot: Please enter a question.")
            continue

        intent = find_intent(user_input)

        if intent is not None:

            response = random.choice(
                intents[intent]["responses"]
            )

            print("Bot:", response)

            if intent == "goodbye":
                break

        else:

            print(
                "Bot: Sorry, I couldn't understand your question."
            )

            print(
                "Bot: You can ask me about orders, products, "
                "returns, payments, working hours, or contact information."
            )


