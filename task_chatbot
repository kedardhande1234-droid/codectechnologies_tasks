# --------------------------------------------------
# NLP Functions
# --------------------------------------------------

def preprocess(sentence):
    """
    Converts the sentence into normalized stemmed words.
    """

    # Convert to lowercase
    sentence = sentence.lower()

    # Tokenize sentence
    words = word_tokenize(sentence)

    # Remove punctuation
    words = [
        word for word in words
        if word not in string.punctuation
    ]

    # Apply stemming
    words = [
        stemmer.stem(word)
        for word in words
    ]

    return words


def calculate_similarity(user_words, pattern_words):
    """
    Calculates simple similarity between
    user's words and pattern words.
    """

    if len(user_words) == 0:
        return 0

    common_words = 0

    for word in user_words:
        if word in pattern_words:
            common_words += 1

    return common_words / len(user_words)


def find_intent(user_input):
    """
    Finds the most suitable customer-service intent.
    """

    user_words = preprocess(user_input)

    best_intent = None
    best_score = 0

    for intent, data in intents.items():

        for pattern in data["patterns"]:

            pattern_words = preprocess(pattern)

            score = calculate_similarity(
                user_words,
                pattern_words
            )

            if score > best_score:
                best_score = score
                best_intent = intent

    # Minimum confidence threshold
    if best_score >= 0.30:
        return best_intent

    return None


