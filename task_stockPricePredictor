# ==========================================================
# Stock Price Predictor
# Machine Learning Project using Linear Regression
# ==========================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score


# ----------------------------------------------------------
# 1. Load Dataset
# ----------------------------------------------------------

file_path = "data/stock_data.csv"

df = pd.read_csv(file_path)

print("\n========== STOCK DATA ==========")
print(df.head())


# ----------------------------------------------------------
# 2. Data Information
# ----------------------------------------------------------

print("\n========== DATA INFORMATION ==========")
print(df.info())

print("\n========== MISSING VALUES ==========")
print(df.isnull().sum())


# ----------------------------------------------------------
# 3. Data Cleaning
# ----------------------------------------------------------

# Convert Date column into datetime format
df["Date"] = pd.to_datetime(df["Date"])

# Sort data according to date
df = df.sort_values("Date")

# Remove rows containing missing values
df = df.dropna()

# Reset index
df = df.reset_index(drop=True)


# ----------------------------------------------------------
# 4. Create Features
# ----------------------------------------------------------

# We use previous day's closing price
# to predict the current day's closing price.

df["Previous_Close"] = df["Close"].shift(1)

# Moving averages
df["MA_5"] = df["Close"].rolling(window=5).mean()
df["MA_10"] = df["Close"].rolling(window=10).mean()

# Remove rows created by rolling calculations
df = df.dropna()


# ----------------------------------------------------------
# 5. Select Features and Target
# ----------------------------------------------------------

features = [
    "Open",
    "High",
    "Low",
    "Volume",
    "Previous_Close",
    "MA_5",
    "MA_10"
]

X = df[features]

# Target variable
y = df["Close"]


# ----------------------------------------------------------
# 6. Split Data into Training and Testing
# ----------------------------------------------------------

# shuffle=False is important for time-series data
X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    shuffle=False
)

print("\n========== DATASET SPLIT ==========")
print("Training samples:", len(X_train))
print("Testing samples:", len(X_test))


# ----------------------------------------------------------
# 7. Create Linear Regression Model
# ----------------------------------------------------------

model = LinearRegression()

model.fit(X_train, y_train)


# ----------------------------------------------------------
# 8. Make Predictions
# ----------------------------------------------------------

y_pred = model.predict(X_test)


# ----------------------------------------------------------
# 9. Evaluate Model
# ----------------------------------------------------------

mae = mean_absolute_error(y_test, y_pred)

rmse = np.sqrt(
    mean_squared_error(y_test, y_pred)
)

r2 = r2_score(y_test, y_pred)


print("\n========== MODEL PERFORMANCE ==========")
print(f"Mean Absolute Error (MAE): {mae:.2f}")
print(f"Root Mean Squared Error (RMSE): {rmse:.2f}")
print(f"R² Score: {r2:.4f}")


# ----------------------------------------------------------
# 10. Compare Actual vs Predicted
# ----------------------------------------------------------

results = pd.DataFrame({
    "Date": df.loc[X_test.index, "Date"],
    "Actual Price": y_test.values,
    "Predicted Price": y_pred
})

print("\n========== PREDICTIONS ==========")
print(results.head(10))


# ----------------------------------------------------------
# 11. Plot Actual vs Predicted Prices
# ----------------------------------------------------------

plt.figure(figsize=(12, 6))

plt.plot(
    results["Date"],
    results["Actual Price"],
    label="Actual Price"
)

plt.plot(
    results["Date"],
    results["Predicted Price"],
    label="Predicted Price"
)

plt.xlabel("Date")
plt.ylabel("Stock Price")

plt.title("Actual vs Predicted Stock Price")

plt.legend()

plt.xticks(rotation=45)

plt.tight_layout()

plt.show()


# ----------------------------------------------------------
# 12. Predict Next Stock Price
# ----------------------------------------------------------

latest_data = df[features].iloc[-1].values.reshape(1, -1)

next_prediction = model.predict(latest_data)

print("\n========== NEXT PRICE PREDICTION ==========")
print(
    f"Predicted next closing price: "
    f"{next_prediction[0]:.2f}"
)
